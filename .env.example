# Public site URL (used for canonical URLs, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (optional) ---
# When set, booking enquiries are translated to Russian via the Claude API.
# Without it the app still works and stores the original message.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Online payment (future) ---
# Placeholders for the upcoming online-banking / acquiring integration.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Notifications (optional) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BOOKINGS_NOTIFY_EMAIL=aitkhozha@gmail.com
